{
  "name": "redux-user-auth",
  "version": "1.0.0",
  "type": "module",
  "description": "User Authentication workflow made with the MERN stack",
  "main": "./backend/server.ts",
  "scripts": {
    "install:all": "pnpm install && pnpm -C backend install && pnpm -C frontend install",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "pnpm -C backend run build",
    "build:frontend": "pnpm -C frontend run build",
    "start": "cd backend && npx tsx server.ts",
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "pnpm -C backend run dev",
    "dev:client": "pnpm -C frontend run dev",
    "typecheck": "pnpm run typecheck:backend && pnpm run typecheck:frontend",
    "typecheck:backend": "pnpm -C backend run typecheck",
    "typecheck:frontend": "pnpm -C frontend run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chinwike1/redux-user-auth.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Chinwike1/redux-user-auth/issues"
  },
  "homepage": "https://github.com/Chinwike1/redux-user-auth#readme",
  "devDependencies": {
    "concurrently": "^7.2.1"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "colors": "^1.4.0",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^6.3.5"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.14.0"
}
